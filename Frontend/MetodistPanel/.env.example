# Service URLs (Vite exposes only VITE_* variables)
VITE_AUTH_API_URL=http://localhost:8080
VITE_ARTIFACTS_API_URL=http://localhost:8081
VITE_ROUTE_API_URL=/api/route
VITE_DASHBOARD_API_URL=/api/dashboard
VITE_ANALYTICS_API_URL=/api/analytics
VITE_FEEDBACK_API_URL=/api/feedback
VITE_NOTIFICATION_API_URL=/api/notification

# Enable real route mutations after RouteService is running.
VITE_ROUTE_API_ENABLED=true
VITE_MUSEUM_ID=mus_001
VITE_NOTIFICATION_USER_ID=usr_001

