{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "lib": ["DOM", "ES2022"],
    "types": ["node", "react", "react-dom"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "vite.config.mjs"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
