<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="urn:vitrine:payment-bpmn:02-methodist">
  <bpmn:collaboration id="Collaboration" name="Оплата подписки из кабинета методиста">
    <bpmn:participant id="Participant" name="Оплата подписки" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="Оплата подписки из кабинета методиста" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Methodist" name="Методист">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Click</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Checkout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="System" name="Витрина">
        <bpmn:flowNodeRef>Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Active</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Нужна подписка">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Open" name="Открыть «Подписку»">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Offer" name="Показать тариф, срок и сумму">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Click" name="Выбрать период и нажать «Оплатить»">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Create" name="Проверить право и открыть оплату">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Checkout" name="Оплатить на странице Точки">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Status" name="Показать статус заказа при возврате">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Result" name="Что показывает кабинет?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Active" name="Платёж подтверждён">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Pending" name="Проверяем оплату">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Failed" name="Оплата не прошла. Можно повторить">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Open" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Open" targetRef="Offer" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Offer" targetRef="Click" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Click" targetRef="Create" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Create" targetRef="Checkout" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Checkout" targetRef="Status" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Status" targetRef="Result" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Result" targetRef="Active" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Result" targetRef="Pending" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Result" targetRef="Failed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram" name="Оплата подписки из кабинета методиста">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1340" height="583" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Methodist_di" bpmnElement="Methodist" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1310" height="265" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="System_di" bpmnElement="System" isHorizontal="true">
        <dc:Bounds x="50" y="285" width="1310" height="318" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="98" y="128" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="69" y="170" width="94" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Open_di" bpmnElement="Open">
        <dc:Bounds x="156" y="110" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Offer_di" bpmnElement="Offer">
        <dc:Bounds x="156" y="354" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Click_di" bpmnElement="Click">
        <dc:Bounds x="344" y="110" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Create_di" bpmnElement="Create">
        <dc:Bounds x="536" y="354" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Checkout_di" bpmnElement="Checkout">
        <dc:Bounds x="732" y="110" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Status_di" bpmnElement="Status">
        <dc:Bounds x="884" y="354" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Result_di" bpmnElement="Result" isMarkerVisible="true">
        <dc:Bounds x="1119" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1007" y="317" width="132" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Active_di" bpmnElement="Active">
        <dc:Bounds x="1273" y="294" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1243" y="334" width="98" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pending_di" bpmnElement="Pending">
        <dc:Bounds x="1273" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1244" y="414" width="94" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Failed_di" bpmnElement="Failed">
        <dc:Bounds x="1273" y="493" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1237" y="534" width="108" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="134" y="146" />
        <di:waypoint x="156" y="146" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="232" y="182" />
        <di:waypoint x="232" y="354" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="308" y="390" />
        <di:waypoint x="420" y="390" />
        <di:waypoint x="420" y="182" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="496" y="146" />
        <di:waypoint x="528" y="146" />
        <di:waypoint x="528" y="390" />
        <di:waypoint x="536" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="688" y="390" />
        <di:waypoint x="710" y="390" />
        <di:waypoint x="710" y="146" />
        <di:waypoint x="732" y="146" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="884" y="146" />
        <di:waypoint x="960" y="146" />
        <di:waypoint x="960" y="354" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1036" y="390" />
        <di:waypoint x="1119" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1144" y="365" />
        <di:waypoint x="1144" y="312" />
        <di:waypoint x="1273" y="312" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1169" y="390" />
        <di:waypoint x="1273" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1144" y="415" />
        <di:waypoint x="1144" y="511" />
        <di:waypoint x="1273" y="511" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>