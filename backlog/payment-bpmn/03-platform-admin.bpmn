<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="urn:vitrine:payment-bpmn:03-platform-admin">
  <bpmn:collaboration id="Collaboration" name="Контроль платежей администратором «Витрины»">
    <bpmn:participant id="Participant" name="Платформа «Витрина»" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="Контроль платежей администратором «Витрины»" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Admin" name="Администратор платформы">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Note</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="System" name="Витрина">
        <bpmn:flowNodeRef>Query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Replay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Processed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tracked</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Очередь или обращение">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Monitor" name="Открыть платежи и проверить статусы">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Issue" name="Нужна проверка?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Done" name="Проверка завершена">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Open" name="Открыть операцию и историю">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Query" name="Сверить операцию с Точкой">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Resolve" name="Данные можно обработать?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Replay" name="Повторить штатную обработку">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Processed" name="Результат обновлён">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Note" name="Зафиксировать вывод и следующий шаг">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Track" name="Сохранить в очереди разбора">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Tracked" name="Разбор продолжается">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Monitor" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Monitor" targetRef="Issue" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Issue" targetRef="Done" name="Нет" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Issue" targetRef="Open" name="Да" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Open" targetRef="Query" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Query" targetRef="Resolve" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Resolve" targetRef="Replay" name="Да" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Replay" targetRef="Processed" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Resolve" targetRef="Note" name="Нет" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Note" targetRef="Track" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Track" targetRef="Tracked" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram" name="Контроль платежей администратором «Витрины»">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1340" height="565" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Admin_di" bpmnElement="Admin" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1310" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="System_di" bpmnElement="System" isHorizontal="true">
        <dc:Bounds x="50" y="300" width="1310" height="285" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="92" y="123" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="63" y="166" width="94" height="29" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Monitor_di" bpmnElement="Monitor">
        <dc:Bounds x="181" y="105" width="152" height="72" />
