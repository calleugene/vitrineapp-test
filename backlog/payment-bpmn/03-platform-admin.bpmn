        <di:waypoint x="630" y="141" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="496" y="118" width="42" height="19" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="442" y="166" />
