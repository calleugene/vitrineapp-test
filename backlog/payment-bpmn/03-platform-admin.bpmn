        <dc:Bounds x="417" y="116" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="382" y="87" width="120" height="23" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done">
        <dc:Bounds x="630" y="123" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="592" y="165" width="112" height="29" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Open_di" bpmnElement="Open">
        <dc:Bounds x="572" y="207" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Query_di" bpmnElement="Query">
        <dc:Bounds x="764" y="350" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Resolve_di" bpmnElement="Resolve" isMarkerVisible="true">
        <dc:Bounds x="1003" y="361" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="887" y="320" width="132" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Replay_di" bpmnElement="Replay">
        <dc:Bounds x="1112" y="350" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Processed_di" bpmnElement="Processed">
        <dc:Bounds x="1306" y="368" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1265" y="412" width="90" height="33" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_di" bpmnElement="Note">
        <dc:Bounds x="952" y="207" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Track_di" bpmnElement="Track">
        <dc:Bounds x="1112" y="470" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tracked_di" bpmnElement="Tracked">
        <dc:Bounds x="1306" y="488" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1265" y="531" width="90" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="128" y="141" />
        <di:waypoint x="181" y="141" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="333" y="141" />
        <di:waypoint x="417" y="141" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
