        <di:waypoint x="724" y="243" />
        <di:waypoint x="840" y="243" />
        <di:waypoint x="840" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="916" y="386" />
