{$SITE_ADDRESS} {
	encode zstd gzip
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	handle_path /api/auth/* {
		reverse_proxy auth-service:8080
	}
	handle_path /api/artifacts/* {
		request_body {
			max_size 100MB
		}
		reverse_proxy artifacts-service:8081
	}
	handle_path /api/visitor/* {
		reverse_proxy visitor-service:8088
	}
	handle_path /api/route/* {
		reverse_proxy route-service:8083
	}
	handle_path /api/feedback/* {
		reverse_proxy feedback-service:8086
	}
	handle_path /api/notification/* {
		reverse_proxy notification-service:8087
	}
	handle_path /api/analytics/* {
		reverse_proxy analytics-service:8085
	}
	handle_path /api/dashboard/* {
		reverse_proxy dashboard-service:8084
	}
	handle /api/* {
		header Content-Type application/json
		respond `{"error":{"code":"not_found","message":"not_found"}}` 404
	}
	handle_path /media-files/* {
		rewrite * /assets{uri}
		reverse_proxy artifacts-service:8081
	}
	redir /methodist /methodist/ 308
	handle_path /methodist/* {
		root * /srv/methodist
		try_files {path} /index.html
		file_server
	}
	handle {
		root * /srv/visitor
		try_files {path} /index.html
		file_server
	}
}
